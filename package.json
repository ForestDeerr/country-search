        "eslint-plugin-prettier": "^5.5.7",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "jest": "^30.5.2",
        "lint-staged": "^17.6.0",
        "prettier": "^3.10.1",
        "ts-jest": "^29.4.15",
        "typescript": "~5.7.3",
